{"full": "<!-- 由 Record.html 自動產生（build_rec.py），請勿直接修改 -->\n<style>\n#v-rec{--bg:#f5f6f8; --panel:#ffffff; --ink:#1f2933; --muted:#6b7785; --line:#e1e5ea;\n    --accent:#1f5fa8; --accent-2:#e8f0fa; --warn:#9a5b00; --warn-bg:#fff4e0;\n    --err:#b03a2e; --err-bg:#fdecea; --ok:#2e7d4f; --ok-bg:#e6f4ea; --radius:8px;}\n#v-rec *{box-sizing:border-box}\n#v-rec{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 \"Noto Sans TC\",\"Microsoft JhengHei\",\"PingFang TC\",system-ui,sans-serif}\n#v-rec .rmain{display:grid;gap:16px;padding:0 0 110px}\n#v-rec .cols{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:16px;align-items:start}\n#v-rec .col{display:grid;gap:16px;min-width:0}\n@media (max-width:1100px){#v-rec .cols{grid-template-columns:1fr}}\n#v-rec section.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;min-width:0}\n#v-rec .card h2{font-size:15px;margin:0 0 10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n#v-rec .card h2 .sp{flex:1}\n#v-rec .step{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:13px;flex:none}\n#v-rec .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n#v-rec input[type=text],#v-rec input[type=search],#v-rec input[type=number],#v-rec select,#v-rec textarea{font:inherit;color:inherit;border:1px solid #c9d0d8;border-radius:6px;padding:5px 8px;background:#fff;min-width:0}\n#v-rec textarea{width:100%;resize:vertical}\n#v-rec button{font:inherit;border:1px solid #c9d0d8;background:#fff;color:var(--ink);border-radius:6px;padding:5px 12px;cursor:pointer}\n#v-rec button:hover{background:#f0f3f6}\n#v-rec button.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n#v-rec button.primary:hover{background:#174b86}\n#v-rec button.mini{padding:1px 8px;font-size:12px}\n#v-rec button:disabled{opacity:.45;cursor:not-allowed}\n#v-rec .muted{color:var(--muted);font-size:13px}\n#v-rec .badge{display:inline-block;font-size:12px;padding:0 7px;border-radius:999px;background:var(--accent-2);color:var(--accent);white-space:nowrap}\n#v-rec .badge.warn{background:var(--warn-bg);color:var(--warn)}\n#v-rec .badge.err{background:var(--err-bg);color:var(--err)}\n#v-rec .badge.ok{background:var(--ok-bg);color:var(--ok)}\n#v-rec .filters select{max-width:9em}\n#v-rec .filters input[type=search]{flex:1;min-width:140px}\n#v-rec .caselist{height:min(46vh,520px);overflow:auto;border:1px solid var(--line);border-radius:8px;margin-top:8px;background:#fff}\n#v-rec .caselist table{width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed}\n#v-rec .caselist th{position:sticky;top:0;background:#fafbfc;color:var(--muted);text-align:left;font-weight:600;padding:6px;white-space:nowrap;cursor:pointer;user-select:none;z-index:1}\n#v-rec .caselist th.sorted{color:var(--accent)}\n#v-rec .caselist th .ar{font-size:10px;margin-left:2px}\n#v-rec .caselist td{padding:5px 6px;border-top:1px solid var(--line);vertical-align:top}\n#v-rec .caselist td .nm{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.35}\n#v-rec .caselist tr.pick{cursor:pointer}\n#v-rec .caselist tr.pick:hover{background:#f7fafd}\n#v-rec .caselist tr.sel{background:var(--accent-2)}\n#v-rec .caselist col.c-date{width:5.8em}\n#v-rec .caselist col.c-type{width:3.4em}\n#v-rec .caselist col.c-unit{width:4.6em}\n#v-rec .caselist col.c-res{width:6.6em}\n#v-rec .selected-case{margin-top:10px;padding:8px 12px;border-left:4px solid var(--accent);background:var(--accent-2);border-radius:6px;font-size:13px}\n#v-rec .drop{border:2px dashed #c9d0d8;border-radius:8px;padding:18px;text-align:center;color:var(--muted);background:#fafbfc;cursor:pointer}\n#v-rec .drop.over{border-color:var(--accent);background:var(--accent-2);color:var(--accent)}\n#v-rec .filebox{margin-top:10px;display:grid;gap:6px}\n#v-rec .fileitem{display:flex;gap:8px;align-items:center;border:1px solid var(--line);border-radius:6px;padding:6px 10px;font-size:13px;flex-wrap:wrap}\n#v-rec .fileitem b{word-break:break-all}\n#v-rec details.raw{margin-top:8px}\n#v-rec details.raw summary{cursor:pointer;color:var(--muted);font-size:13px}\n#v-rec details.raw pre{white-space:pre-wrap;font-size:12px;background:#f6f7f5;padding:8px;border-radius:6px;max-height:300px;overflow:auto;margin:6px 0 0}\n#v-rec .sub{font-size:13px;font-weight:600;color:var(--muted);margin:12px 0 4px;display:flex;align-items:center;gap:8px}\n#v-rec .scorebox{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:6px}\n#v-rec .scorebox input{width:7em;font-size:16px;font-weight:700}\n#v-rec .grade{font-size:18px;font-weight:700;color:var(--accent)}\n#v-rec .items{width:100%;border-collapse:collapse;font-size:13.5px}\n#v-rec .items th{background:#fafbfc;color:var(--muted);text-align:left;padding:5px;font-size:12.5px;font-weight:600;white-space:nowrap}\n#v-rec .items td{border-top:1px solid var(--line);padding:4px 5px;vertical-align:top}\n#v-rec .items td textarea{min-height:34px;font-size:13.5px;padding:4px 6px}\n#v-rec .items td input{width:100%}\n#v-rec .items .w-no{width:2.4em}\n#v-rec .items .w-code{width:10.5em}\n#v-rec .items .w-lv{width:4.4em}\n#v-rec .items .w-pt{width:4em}\n#v-rec .items .w-del{width:2.8em}\n#v-rec .items tr.flag td{background:#fffaf0}\n#v-rec .codehint{font-size:11.5px;color:var(--muted);margin-top:2px}\n#v-rec .checks{margin:10px 0 0;padding:0;list-style:none;display:grid;gap:3px;font-size:13px}\n#v-rec .checks li{padding:4px 10px;border-radius:6px}\n#v-rec .checks li.warn{background:var(--warn-bg);color:var(--warn)}\n#v-rec .checks li.err{background:var(--err-bg);color:var(--err)}\n#v-rec .checks li.ok{background:var(--ok-bg);color:var(--ok)}\n#v-rec .cmp{width:100%;border-collapse:collapse;font-size:13px}\n#v-rec .cmp th{background:#fafbfc;color:var(--muted);text-align:left;padding:5px 6px;font-weight:600}\n#v-rec .cmp td{border-top:1px solid var(--line);padding:5px 6px;vertical-align:top;word-break:break-all}\n#v-rec .cmp tr.diff td{background:#fffaf0}\n#v-rec .cmp tr.same td.st{color:var(--ok)}\n#v-rec .cmp tr.diff td.st{color:var(--warn);font-weight:600}\n#v-rec .cmp td.st{white-space:nowrap;width:5.5em}\n#v-rec .cmp td.k{white-space:nowrap;width:6.5em;color:var(--muted)}\n#v-rec .actionbar{position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.97);border-top:1px solid var(--line);padding:10px 16px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;z-index:5;align-items:center}\n#v-rec .toast{position:fixed;left:50%;bottom:72px;transform:translateX(-50%);background:#263238;color:#fff;padding:8px 16px;border-radius:8px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:9}\n#v-rec .toast.show{opacity:1}\n#v-rec .loading{padding:20px;text-align:center;color:var(--muted)}\n#v-rec .note{font-size:12.5px;color:var(--muted);margin-top:8px}\n#v-rec .empty-hint{padding:30px 10px;text-align:center;color:var(--muted)}\n</style>\n<div class=\"rmain\">\n<div class=\"cols\">\n  <!-- 左：選擇案件、上傳紀錄表 -->\n  <div class=\"col left\">\n    <section class=\"card\">\n      <h2><span class=\"step\">1</span>選擇案件<span class=\"sp\"></span><span class=\"muted\" id=\"loadedAt\" style=\"font-weight:400;font-size:12px\"></span></h2>\n      <div class=\"row filters\">\n        <select id=\"rfYear\" title=\"年度\"></select>\n        <select id=\"rfMonth\" title=\"月份\"></select>\n        <select id=\"rfType\" title=\"項目\"></select>\n        <select id=\"rfState\" title=\"登錄狀態\">\n          <option value=\"\">全部狀態</option><option value=\"pend\">待登錄</option><option value=\"done\">已登錄</option><option value=\"nodef\">缺失未建立</option><option value=\"nofile\">已登錄、未上傳紀錄表</option>\n        </select>\n        <input type=\"search\" id=\"q\" placeholder=\"搜尋工程名稱、單位…\">\n      </div>\n      <div class=\"caselist\" id=\"caseList\"><div class=\"loading\">讀取案件中…</div></div>\n      <div id=\"selectedCase\"></div>\n    </section>\n\n    <section class=\"card\">\n      <h2><span class=\"step\">2</span>上傳督導／查核紀錄表</h2>\n      <div class=\"drop\" id=\"drop\">將紀錄表拖曳到這裡，或<b>點此選擇檔案</b><br><span class=\"muted\">接受 .odt、.docx、.doc、.pdf（請上傳最終版紀錄表；.doc 與掃描 PDF 會以 Google 文件轉檔取文字）</span></div>\n      <input type=\"file\" id=\"fileInput\" accept=\".odt,.docx,.doc,.pdf\" hidden>\n      <div class=\"filebox\" id=\"fileBox\"></div>\n      <details class=\"raw\" id=\"rawBox\" style=\"display:none\"><summary>檢視解析出的原文</summary><pre id=\"rawText\"></pre></details>\n      <div class=\"sub\" style=\"margin-top:14px\">已儲存的紀錄表原檔</div>\n      <div class=\"filebox\" id=\"savedFiles\"><span class=\"muted\">請先選擇案件</span></div>\n    </section>\n  </div>\n\n  <!-- 右：結果、比對 -->\n  <div class=\"col right\">\n    <section class=\"card\">\n      <h2><span class=\"step\">3</span>督導結果（由紀錄表解析，可修改）<span class=\"sp\"></span><span class=\"muted\" id=\"kindTag\"></span></h2>\n      <div id=\"resultBox\"><div class=\"empty-hint\">選擇案件並上傳紀錄表後，這裡會顯示分數、缺失與委員意見。</div></div>\n    </section>\n    <section class=\"card\">\n      <h2><span class=\"step\">4</span>工程基本資料比對<span class=\"sp\"></span><span class=\"muted\" style=\"font-weight:400\">勾選「更新」的欄位，儲存時以紀錄表內容寫回資料庫</span></h2>\n      <div id=\"cmpBox\"><div class=\"empty-hint\">上傳紀錄表後自動比對。</div></div>\n    </section>\n  </div>\n</div>\n</div>\n\n<div class=\"actionbar\">\n  <span class=\"muted\" id=\"saveHint\"></span>\n  <button class=\"primary\" id=\"rBtnSave\" disabled>儲存結果到資料庫（含紀錄表原檔）</button>\n</div>\n<div class=\"toast\" id=\"rtoast\"></div>\n<datalist id=\"codeList\"></datalist>\n<script>\nwindow.REC_EMBED = true;\n(function(){\n\n/* =====================================================================\n * 督導紀錄登錄（115/10 改版）\n * 流程：選擇案件 → 上傳最終版督導／查核紀錄表（.odt／.docx／.doc／.pdf）\n *       → 解析分數、優點、缺點（代碼、等級、扣點）、規劃設計問題及建議、其他建議、檢驗拆驗、品質指標\n *       → 與資料庫的工程基本資料比對（可勾選更新）\n *       → 儲存：成績、缺失、完整內容、紀錄表原檔（存擁有者雲端硬碟，日後可在系統內下載）\n * ===================================================================== */\nconst PDFJS_URL  = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs';\nconst PDFJS_WORKER_URL = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs';\nconst MAX_FILE = 20 * 1024 * 1024;\nconst S = { cases: [], codes: {}, sel: null, file: null, rec: null, saved: null, perms: null, cmp: [] };\n\n/* ---------- 小工具 ---------- */\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nfunction toast(msg, ms){ const t=$('rtoast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove('show'), ms||2400); }\n/** google.script.run 包成 Promise；本機測試時改用 window.__MOCK__ */\nfunction gs(fn, ...args){\n  if (window.google && google.script && google.script.run)\n    return new Promise((res,rej)=> google.script.run.withSuccessHandler(res).withFailureHandler(rej)[fn](...args));\n  if (window.__MOCK__ && window.__MOCK__[fn]) return Promise.resolve(window.__MOCK__[fn](...args));\n  return Promise.reject(new Error('請由督導查核系統開啟本頁'));\n}\nconst api = (action, args) => gs('api', action, args || {});\n/* 民國年顯示（與主頁共用；單獨開啟時自行轉換） */\nfunction R(x){ if(window.dkRoc) return window.dkRoc(x); return String(x==null?'':x).replace(/(^|[^0-9])(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})(?![0-9])/g,(m,a,y,mo,d)=>a+(y-1911)+'/'+String(mo).padStart(2,'0')+'/'+String(d).padStart(2,'0')); }\nconst pad = n => String(n).padStart(2,'0');\n/** 民國日期文字（115年6月16日、115/06/16、115.6.16）→ 2026-06-16 */\nfunction rocToIso(s){ const m=String(s||'').match(/(\\d{2,3})\\s*[年\\/.\\-]\\s*(\\d{1,2})\\s*[月\\/.\\-]\\s*(\\d{1,2})/); return m? (+m[1]+1911)+'-'+pad(m[2])+'-'+pad(m[3]) : ''; }\nfunction gradeOf(score){ const s=parseFloat(score); if(isNaN(s)) return String(score||'').trim()==='不計分'?'不計分':''; return s>=90?'優等':s>=80?'甲等':s>=70?'乙等':'丙等'; }\nconst num = v => { const n=parseFloat(String(v??'').replace(/[,，\\s]/g,'')); return isNaN(n)?null:n; };\nfunction blobToB64(blob){ return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(String(r.result).split(',')[1]); r.onerror=rej; r.readAsDataURL(blob); }); }\nconst coll = new Intl.Collator('zh-Hant-TW',{numeric:true});\nconst canEdit = () => !S.perms || S.perms.indexOf('督導紀錄編輯') >= 0;\nconst nameKey = s => String(s||'').replace(/[\\s()（）、，,。.\\-－~～]/g,'');\n\n/* =====================================================================\n * 1. 案件清單（年度、月份、項目、狀態篩選；精簡欄位）\n * ===================================================================== */\nconst DJ_LS='dk_dj_v2';\nlet preDone=false;\nlet PRE_ID='';\nasync function loadInit(){\n  let cached=null;\n  try{ localStorage.removeItem('dk_dj_v1'); cached=JSON.parse(localStorage.getItem(DJ_LS)||'null'); }catch(e){}\n  if(cached && cached.v===2){ try{ applyInit(cached,true); }catch(e){} }\n  try{\n    const d = await gs('getInitData');\n    try{ localStorage.setItem(DJ_LS, JSON.stringify(d)); }catch(e){}\n    applyInit(d,false);\n  }catch(e){\n    if(cached){ toast('無法讀取最新資料：'+(e.message||e)); return; }\n    $('caseList').innerHTML = `<div class=\"loading\" style=\"color:var(--err)\">案件讀取失敗：${esc(e.message||e)}</div>`;\n  }\n}\nfunction applyInit(d, stale){\n  const selId = S.sel && S.sel['案件編號'];\n  S.cases = (d.schedule||[]).map(r=>({...r}));\n  S.codes = d.codes || {};\n  S.perms = d.perms || S.perms;\n  $('codeList').innerHTML = Object.entries(S.codes).map(([c,t])=>`<option value=\"${esc(c)}\">${esc(String(t).replace(/□/g,'').slice(0,40))}</option>`).join('');\n  $('loadedAt').textContent = stale ? '暫存資料，更新中…' : '資料讀取：'+R(d.loadedAt);\n  initFilters();\n  if (selId) { const c = S.cases.find(x => x['案件編號'] === selId); if (c) S.sel = c; }\n  renderCases();\n  if (PRE_ID && !preDone) { const c = S.cases.find(x => x['案件編號'] === PRE_ID); if (c) { preDone = true; focusCase(c); } }\n  $('rBtnSave').style.display = canEdit() ? '' : 'none';\n}\nfunction initFilters(){\n  const ys=[...new Set(S.cases.map(c=>+c['年度']).filter(Boolean))].sort((a,b)=>b-a);\n  const curY=$('rfYear').value || String(new Date().getFullYear()-1911);\n  $('rfYear').innerHTML='<option value=\"\">全部年度</option>'+ys.map(y=>`<option value=\"${y}\">${y} 年</option>`).join('');\n  $('rfYear').value = ys.indexOf(+curY)>=0 ? curY : (ys[0]?String(ys[0]):'');\n  if(!$('rfMonth').options.length) $('rfMonth').innerHTML='<option value=\"\">全部月份</option>'+Array.from({length:12},(_,i)=>`<option value=\"${i+1}\">${i+1} 月</option>`).join('');\n  const curT=$('rfType').value, ts=[...new Set(S.cases.map(c=>c['項目']).filter(Boolean))];\n  $('rfType').innerHTML='<option value=\"\">全部項目</option>'+ts.map(t=>`<option>${esc(t)}</option>`).join('');\n  $('rfType').value=curT;\n}\n['rfYear','rfMonth','rfType','rfState'].forEach(id=>$(id).onchange=renderCases);\n$('q').oninput=renderCases;\nS.sort = (()=>{ try{ return JSON.parse(localStorage.getItem('dk_sort_rec2'))||null; }catch(e){ return null; } })() || {k:'日期', d:-1};\nconst shortType = t => ({'代部查核':'代部','本部查核':'本部','中央查核':'中央'}[t]||t);\nconst shortUnit = u => String(u||'').replace(/管理處$/,'').replace(/(縣|市)政府$/,'$1府');\nconst hasRes = c => (c['成績']!==''&&c['成績']!=null) || +c['缺失數']>0;\nfunction sortVal(c,k){\n  if(k==='結果'){ const n=parseFloat(c['成績']); return isNaN(n)?(hasRes(c)?0:''):n; }\n  if(k==='單位' && window.dkUnitRank) return window.dkUnitRank(c[k]);\n  return c[k]==null?'':String(c[k]);\n}\nfunction renderCases(){\n  const y=$('rfYear').value, m=$('rfMonth').value, t=$('rfType').value, st=$('rfState').value, q=$('q').value.trim().toLowerCase();\n  const list=S.cases.filter(c=> (!y || String(c['年度'])===y) && (!m || (c['日期'] && +c['日期'].slice(5,7)===+m)) && (!t || c['項目']===t) &&\n    (!st || (st==='pend'&&!hasRes(c)&&c['狀態']!=='已排定') || (st==='done'&&hasRes(c)) || (st==='nodef'&&c['缺失未建立']) || (st==='nofile'&&hasRes(c)&&!c['原檔'])) &&\n    (!q || [c['案件編號'],c['工程名稱'],c['單位'],R(c['日期'])].join(' ').toLowerCase().includes(q)));\n  const k=S.sort.k, d=S.sort.d;\n  list.sort((a,b)=>{ const va=sortVal(a,k), vb=sortVal(b,k); if((va==='')!==(vb==='')) return va===''?1:-1;\n    const r = va===''?0 : typeof va==='number'? va-vb : coll.compare(va,vb); return r*d || String(b['日期']).localeCompare(String(a['日期'])); });\n  if(!list.length){ $('caseList').innerHTML='<div class=\"loading\">沒有符合的案件</div>'; return; }\n  const TH=[['日期','日期','c-date'],['項目','項目','c-type'],['單位','單位','c-unit'],['工程名稱','工程名稱',''],['結果','結果','c-res']];\n  const res = c => c['狀態']==='已排定' ? '<span class=\"muted\">未辦理</span>' : !hasRes(c) ? '<span class=\"badge warn\">待登錄</span>' :\n    `<b>${esc(c['成績']||'—')}</b> <span class=\"muted\">${c['缺失未建立']?'缺失未建':(c['缺失數']||0)+'項'}</span>${c['原檔']?' <span title=\"已上傳紀錄表原檔\">📎</span>':''}`;\n  $('caseList').innerHTML = `<table><colgroup>${TH.map(x=>`<col class=\"${x[2]}\">`).join('')}</colgroup><thead><tr>${TH.map(([key,l])=>`<th data-k=\"${key}\" class=\"${k===key?'sorted':''}\" title=\"點選排序\">${l}${k===key?`<span class=\"ar\">${d<0?'▼':'▲'}</span>`:''}</th>`).join('')}</tr></thead><tbody>${\n    list.map(c=>`<tr class=\"pick ${S.sel&&S.sel['案件編號']===c['案件編號']?'sel':''}\" data-id=\"${esc(c['案件編號'])}\" title=\"${esc(c['案件編號']+'｜'+c['單位']+'｜'+c['工程名稱'])}\"><td>${c['日期']?esc(R(c['日期'])):'<span class=\"muted\">未定</span>'}</td><td>${esc(shortType(c['項目']))}</td><td>${esc(shortUnit(c['單位']))}</td><td><div class=\"nm\">${esc(c['工程名稱'])}</div></td><td>${res(c)}</td></tr>`).join('')\n  }</tbody></table>`;\n  $('caseList').querySelectorAll('tr.pick').forEach(tr=>tr.onclick=()=>selectCase(tr.dataset.id));\n  $('caseList').querySelectorAll('th[data-k]').forEach(th=>th.onclick=()=>{\n    const key=th.dataset.k; S.sort = S.sort.k===key ? {k:key, d:-S.sort.d} : {k:key, d: ['日期','結果'].includes(key) ? -1 : 1};\n    try{ localStorage.setItem('dk_sort_rec2', JSON.stringify(S.sort)); }catch(e){}\n    renderCases();\n  });\n}\n/** 由其他頁指定案件：切到該年度、月份後選取 */\nfunction focusCase(c){\n  if(String(c['年度'])!==$('rfYear').value) $('rfYear').value=String(c['年度']||'');\n  $('rfMonth').value=''; $('rfState').value=''; $('q').value='';\n  selectCase(c['案件編號']);\n  const tr=$('caseList').querySelector('tr.sel'); if(tr) tr.scrollIntoView({block:'center'});\n}\nfunction selectCase(id){\n  const c=S.cases.find(x=>x['案件編號']===id); if(!c) return;\n  if(S.sel && S.sel['案件編號']!==id && S.file && !confirm('切換案件會清除目前上傳、尚未儲存的紀錄表，確定？')) return;\n  if(!S.sel || S.sel['案件編號']!==id){ S.file=null; S.rec=null; S.saved=null; }\n  S.sel=c;\n  $('selectedCase').innerHTML = `<div class=\"selected-case\"><b>${esc(c['工程名稱'])}</b><br><span class=\"muted\">${esc(c['案件編號'])}｜${esc(R(c['日期'])||'日期未定')}｜${esc(c['項目'])}｜${esc(c['單位'])}｜委員：${esc([c['委員1'],c['委員2']].filter(Boolean).join('、')||'—')}｜目前：${hasRes(c)?'成績 '+esc(c['成績']||'—')+'、缺失 '+(c['缺失數']||0)+' 項':'尚未登錄'}</span></div>`;\n  renderCases(); renderFile(); renderResult(); renderCmp(); updateSave();\n  loadSaved(c);\n}\n/* 已儲存的結果與原檔清單；有完整內容則帶回右側供檢視或修改 */\nasync function loadSaved(c){\n  const id=c['案件編號'];\n  $('savedFiles').innerHTML='<span class=\"muted\">讀取中…</span>';\n  let r; try{ r=await gs('getRecord', id); }catch(e){ $('savedFiles').innerHTML='<span class=\"muted\">讀取失敗：'+esc(e.message||e)+'</span>'; return; }\n  if(!S.sel || S.sel['案件編號']!==id) return;\n  S.saved=r;\n  $('savedFiles').innerHTML = (r.files||[]).length ? r.files.map(f=>`<div class=\"fileitem\">📎 <b>${esc(f.檔名)}</b><span class=\"muted\">${esc(R(f.上傳時間))}　${esc(f.上傳者)}${f.大小?'　'+Math.max(1,Math.round(f.大小/1024))+' KB':''}</span><button class=\"mini\" data-fid=\"${esc(f.檔案ID)}\" data-fn=\"${esc(f.檔名)}\">下載</button></div>`).join('')\n    : '<span class=\"muted\">此案件尚未上傳紀錄表原檔</span>';\n  $('savedFiles').querySelectorAll('[data-fid]').forEach(b=>b.onclick=()=>downloadSaved(b.dataset.fid, b.dataset.fn, b));\n  if(S.file || S.rec) return;   // 已上傳新檔或已開始輸入就不覆蓋\n  const ct=r.content;\n  if(ct && ct.v===2){ S.rec=JSON.parse(JSON.stringify(ct)); S.rec._fromSaved=true; }\n  else if((r.defects||[]).length || r.成績){\n    S.rec={ v:2, kind:'', score:r.成績||'', good:[], design:[], other:[], inspect:'', quality:'', fields:{}, badTotal:'', _fromSaved:true,\n      bad:(r.defects||[]).map(d=>{ const p=splitDefect(d.缺失紀錄); return {text:p.text, code:String(d.缺失代碼||p.code||''), level:String(d.缺失等級||p.level||''), points:d.扣點===''||d.扣點==null?'':String(d.扣點)}; }) };\n  }\n  renderResult(); renderCmp(); updateSave();\n}\nasync function downloadSaved(fid, name, btn){\n  btn.disabled=true; btn.textContent='下載中…';\n  try{\n    const f=await api('djFile',{fileId:fid});\n    const bin=atob(f.base64), u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++) u[i]=bin.charCodeAt(i);\n    const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([u],{type:f.mimeType||'application/octet-stream'})); a.download=f.name||name; document.body.appendChild(a); a.click(); a.remove();\n    setTimeout(()=>URL.revokeObjectURL(a.href),5000);\n  }catch(e){ toast('下載失敗：'+(e.message||e),4000); }\n  btn.disabled=false; btn.textContent='下載';\n}\n\n/* =====================================================================\n * 2. 上傳與解析\n * ===================================================================== */\nfunction setupDrop(){\n  const drop=$('drop'), inp=$('fileInput');\n  drop.onclick=()=>inp.click();\n  inp.onchange=()=>{ if(inp.files[0]) addFile(inp.files[0]); inp.value=''; };\n  drop.ondragover=e=>{ e.preventDefault(); drop.classList.add('over'); };\n  drop.ondragleave=()=>drop.classList.remove('over');\n  drop.ondrop=e=>{ e.preventDefault(); drop.classList.remove('over'); if(e.dataTransfer.files[0]) addFile(e.dataTransfer.files[0]); };\n}\nasync function addFile(file){\n  if(!S.sel){ toast('請先在左側選擇案件'); return; }\n  const ext=(file.name.split('.').pop()||'').toLowerCase();\n  if(['odt','docx','doc','pdf'].indexOf(ext)<0){ toast('只接受 .odt、.docx、.doc、.pdf'); return; }\n  if(file.size>MAX_FILE){ toast('檔案超過 20MB'); return; }\n  S.file={file, name:file.name, ext, status:'解析中…', lines:[]};\n  S.rec=null;\n  renderFile();\n  try{\n    const lines = await extractLines(S.file);\n    S.file.lines=lines;\n    const rec=parseRecord(lines);\n    if(!rec.found) throw new Error('看不出是督導／查核紀錄表（找不到「標案名稱」「缺點」等欄位），請確認檔案；仍可展開下方原文對照，或改用手動輸入');\n    S.rec=rec; S.file.status='已解析：分數 '+(rec.score||'—')+'、缺點 '+rec.bad.length+' 項';\n  }catch(e){ S.file.status='解析失敗：'+(e.message||e); }\n  renderFile(); renderResult(); renderCmp(); updateSave();\n}\nfunction renderFile(){\n  const f=S.file;\n  $('fileBox').innerHTML = f ? `<div class=\"fileitem\">📄 <b>${esc(f.name)}</b><span class=\"muted\">${Math.max(1,Math.round(f.file.size/1024))} KB｜${esc(f.status)}</span><button class=\"mini\" id=\"fileClr\">移除</button></div>` : '';\n  if(f) $('fileClr').onclick=()=>{ S.file=null; S.rec=null; renderFile(); renderResult(); renderCmp(); updateSave(); if(S.sel) loadSaved(S.sel); };\n  $('rawBox').style.display = f && f.lines.length ? '' : 'none';\n  $('rawText').textContent = f ? f.lines.join('\\n') : '';\n}\n/* ---- 取出文字行：表格每一格、每一段落各成一行 ---- */\nasync function extractLines(f){\n  if(f.ext==='docx'){\n    const z=await JSZip.loadAsync(f.file); const x=await z.file('word/document.xml').async('string');\n    return xmlParagraphs(x,'w:p','w:t',['w:tab'],['w:br','w:cr']);\n  }\n  if(f.ext==='odt'){\n    const z=await JSZip.loadAsync(f.file); return odtParagraphs(await z.file('content.xml').async('string'));\n  }\n  if(f.ext==='doc'){\n    // 工程會系統匯出的 .doc 其實是 HTML 檔，可直接在瀏覽器解析；真正的 Word 97 檔才需轉檔\n    const head=new TextDecoder('utf-8').decode(await f.file.slice(0,4096).arrayBuffer());\n    if(/<html|<table|<body/i.test(head)) return htmlLines(await f.file.text());\n  }\n  if(f.ext==='pdf'){\n    let lines=[]; try{ lines=await pdfLines(f.file); }catch(e){}\n    if(lines.join('').replace(/\\s/g,'').length>80) return lines;\n    f.status='掃描檔，以 Google 文件辨識文字中…'; renderFile();\n  } else { f.status='以 Google 文件轉檔中…'; renderFile(); }\n  const mime = f.ext==='pdf' ? 'application/pdf' : 'application/msword';\n  const text = await gs('convertToText', await blobToB64(f.file), mime, f.name);\n  return String(text||'').split(/\\r?\\n/).map(s=>s.replace(/\\s+$/,'')).filter(s=>s.trim());\n}\n/** HTML（表格）→ 行：每個區塊元素（div、p、td、th、li、br）各成一行 */\nfunction htmlLines(html){\n  const doc=new DOMParser().parseFromString(html,'text/html'); const out=[]; let cur='';\n  const flush=()=>{ cur.split(/\\n/).forEach(x=>{ x=x.replace(/\\u00a0/g,' ').trim(); if(x) out.push(x); }); cur=''; };\n  const BLK=/^(DIV|P|TD|TH|TR|LI|UL|OL|TABLE|TBODY|THEAD|H[1-6]|SECTION|ARTICLE|CENTER)$/;\n  const walk=n=>{ for(const c of n.childNodes){\n    if(c.nodeType===3){ cur+=c.nodeValue; continue; }\n    if(c.nodeType!==1 || /^(SCRIPT|STYLE|HEAD)$/.test(c.nodeName)) continue;\n    if(c.nodeName==='BR'){ flush(); continue; }\n    const b=BLK.test(c.nodeName); if(b) flush(); walk(c); if(b) flush();\n  }};\n  walk(doc.body||doc.documentElement); flush();\n  return out;\n}\nfunction xmlParagraphs(xml, pTag, tTag, tabTags, brTags){\n  const doc=new DOMParser().parseFromString(xml,'application/xml'); const out=[];\n  for(const p of doc.getElementsByTagName(pTag)){\n    let s='';\n    const walk=n=>{ for(const c of n.childNodes){\n      if(c.nodeType!==1 || c.nodeName===pTag) continue;\n      if(c.nodeName===tTag) s+=c.textContent;\n      else if(tabTags.includes(c.nodeName)||brTags.includes(c.nodeName)) s+=' ';\n      else walk(c);\n    }};\n    walk(p); if(s.trim()) out.push(s);\n  }\n  return out;\n}\nfunction odtParagraphs(xml){\n  const doc=new DOMParser().parseFromString(xml,'application/xml'); const out=[];\n  const isP=n=>n.nodeName==='text:p'||n.nodeName==='text:h';\n  const all=[...doc.getElementsByTagName('text:p'),...doc.getElementsByTagName('text:h')];\n  all.sort((a,b)=> a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);\n  for(const p of all){\n    let s='';\n    const walk=n=>{ for(const c of n.childNodes){\n      if(c.nodeType===3){ s+=c.nodeValue; continue; }\n      if(c.nodeType!==1 || isP(c)) continue;\n      if(c.nodeName==='text:s') s+=' '.repeat(+c.getAttribute('text:c')||1);\n      else if(c.nodeName==='text:tab'||c.nodeName==='text:line-break') s+=' ';\n      else walk(c);\n    }};\n    walk(p); if(s.trim()) out.push(s);\n  }\n  return out;\n}\nlet _pdfjs=null;\nasync function getPdfjs(){\n  if(_pdfjs) return _pdfjs;\n  const lib=await import(PDFJS_URL);\n  try{ const code=await (await fetch(PDFJS_WORKER_URL)).text(); lib.GlobalWorkerOptions.workerPort=new Worker(URL.createObjectURL(new Blob([code],{type:'text/javascript'})),{type:'module'}); }\n  catch(e){ lib.GlobalWorkerOptions.workerSrc=PDFJS_WORKER_URL; }\n  return _pdfjs=lib;\n}\n/** PDF 文字：依 y 分列，同一列字距過大（表格不同格）時拆成不同行 */\nasync function pdfLines(file){\n  const lib=await getPdfjs();\n  const pdf=await lib.getDocument({data:new Uint8Array(await file.arrayBuffer())}).promise;\n  const out=[];\n  for(let p=1;p<=pdf.numPages;p++){\n    const tc=await (await pdf.getPage(p)).getTextContent(); const rows=[];\n    tc.items.forEach(it=>{ if(!it.str||!it.str.trim()) return; const y=Math.round(it.transform[5]); let r=rows.find(r=>Math.abs(r.y-y)<=3); if(!r){r={y,parts:[]};rows.push(r);} r.parts.push({x:it.transform[4], w:it.width||0, s:it.str, h:Math.abs(it.transform[3])||10}); });\n    rows.sort((a,b)=>b.y-a.y).forEach(r=>{\n      const ps=r.parts.sort((a,b)=>a.x-b.x); let cur=ps[0].s, end=ps[0].x+ps[0].w;\n      for(let i=1;i<ps.length;i++){ if(ps[i].x-end > ps[i].h*1.6){ out.push(cur); cur=ps[i].s; } else cur+=ps[i].s; end=ps[i].x+ps[i].w; }\n      out.push(cur);\n    });\n  }\n  return out.map(s=>s.replace(/\\s{2,}/g,' '));\n}\n\n/* ---- 解析紀錄表 ----\n * 依欄位標籤切段；標籤可能被拆成多行（如「優」「點」、「列管計」「畫名稱」），最多合併 3 行比對 */\nconst NORM = s => String(s||'').replace(/\\s+/g,'').replace(/（/g,'(').replace(/）/g,')').replace(/[：:]$/,'');\nconst HEAD_LABELS = {\n  '列管計畫名稱':'plan','計畫主辦機關':'planOrg','標案所屬工程主管機關':'authority','督導日期':'date','查核日期':'date','標案名稱':'name','地點':'place',\n  '標案主辦單位':'org','標案執行機關':'org','專案管理單位':'pcm','發包預算(千元)':'budget','發包預算':'budget','契約金額(千元)':'contract','契約金額':'contract',\n  '設計單位':'designer','監造單位':'supervisor','承攬廠商':'contractor','承包商':'contractor','工程概要':'summary',\n  '督導委員':'committee','查核委員':'committee','開工及預定完工日期':'period','領隊及工作人員':'leader',\n  '督導分數(等級)':'score','查核分數(等級)':'score','督導分數':'score','查核分數':'score'\n};\nconst BODY_LABELS = { '優點':'good','缺點':'bad','規劃設計建議':'design','規劃設計問題及建議':'design','品質指標':'quality','其他建議':'other','扣點統計':'points','檢驗拆驗':'inspect' };\nconst BODY_KEYS = ['good','bad','design','other','quality','points','inspect','badTotal'];\nfunction labelAt(lines, i, body){\n  for(let n=3;n>=1;n--){\n    if(i+n>lines.length) continue;\n    const t=NORM(lines.slice(i,i+n).join(''));\n    if(!body && HEAD_LABELS[t]) return {key:HEAD_LABELS[t], n};\n    if(BODY_LABELS[t]) return {key:BODY_LABELS[t], n};\n    if(n===1 && !body && /^工程進度/.test(t) && t.length<=24) return {key:'progress', n};\n    if(n===1 && /^缺點總計扣點數/.test(t)) return {key:'badTotal', n, rest:t.replace(/^缺點總計扣點數/,'')};\n  }\n  return null;\n}\nfunction parseRecord(lines){\n  const sec={}, title=lines.slice(0,2).join('');\n  let cur=null, body=false;\n  for(let i=0;i<lines.length;){\n    const L=labelAt(lines,i,body);\n    if(L){ cur=L.key; if(BODY_KEYS.indexOf(cur)>=0) body=true; sec[cur]=sec[cur]||[]; if(L.rest) sec[cur].push(L.rest); i+=L.n; continue; }\n    if(cur) sec[cur].push(lines[i].trim());\n    i++;\n  }\n  const J = k => (sec[k]||[]).join('\\n').trim();\n  const rec = { v:2, found: !!(sec.name && (sec.bad||sec.good||sec.score)), kind: /查核/.test(title)?'查核':'督導', title: title.slice(0,60), fields:{} };\n  ['plan','planOrg','authority','name','place','org','pcm','designer','supervisor','contractor','summary','progress','committee','period','leader','budget','contract','date'].forEach(k=>rec.fields[k]=J(k));\n  const st=J('score'), sm=st.match(/(\\d{2,3}(?:\\.\\d+)?)/);\n  rec.score = /不計分/.test(st) ? '不計分' : sm ? sm[1] : '';\n  rec.good = splitItems(sec.good||[]);\n  rec.bad = splitItems(sec.bad||[]).map(splitDefect);\n  rec.design = splitItems(sec.design||[]);\n  rec.other = splitItems(sec.other||[]);\n  rec.quality = J('quality');\n  rec.inspect = J('inspect').replace(/^[(（]?無[)）]?。?$/,'無');\n  rec.badTotal = (J('badTotal').match(/(\\d+)/)||[])[1]||'';\n  return rec;\n}\n/** 段落切條：有編號（1. 2.）時依編號合併跨行；沒有編號則每段一條；略過「● 監造單位：」「建議：」等小標與「無」 */\nfunction splitItems(lines){\n  const ls=lines.map(s=>s.trim()).filter(s=>s && !/^[●○◎■◆]/.test(s) && !/^(建議|意見)[：:]?$/.test(s) && !/^[(（]?無[)）]?。?$/.test(s));\n  const NUMRE=/^\\s*(\\d{1,2})\\s*[.、．)）]\\s*/;\n  if(ls.some(s=>NUMRE.test(s))){\n    const out=[];\n    ls.forEach(s=>{ if(NUMRE.test(s)) out.push(s.replace(NUMRE,'')); else if(out.length) out[out.length-1]+=s; else out.push(s); });\n    return out.map(s=>s.trim()).filter(Boolean);\n  }\n  return ls;\n}\n/** 缺點：拆出代碼、等級、扣點（支援「…。【L】(4.02.01.06)」與「…。4.01.04.01(L)」兩種寫法） */\nfunction splitDefect(t){\n  let s=String(t||'').trim(), code='', level='', points='';\n  const pm=s.match(/扣\\s*(\\d+(?:\\.\\d+)?)\\s*點/); if(pm) points=pm[1];\n  const codes=[...s.matchAll(/(\\d\\.\\d{2}(?:\\.\\d{2}){0,3})/g)].map(m=>m[1]);\n  if(codes.length) code=codes[codes.length-1];\n  const lm=s.match(/[【\\[(（]\\s*([LMS])\\s*[】\\])）]/); if(lm) level=lm[1];\n  s=s.replace(/\\s*[(（]?\\s*扣\\s*\\d+(?:\\.\\d+)?\\s*點\\s*[)）]?\\s*/g,'');\n  for(let k=0;k<4;k++) s=s.replace(/\\s*(?:[【\\[(（]\\s*[LMS]\\s*[】\\])）]|[(（]?\\d\\.\\d{2}(?:\\.\\d{2}){0,3}[)）]?)\\s*[。.]?\\s*$/,'');\n  s=s.trim(); if(s && !/[。！？]$/.test(s)) s+='。';\n  if(!level && code) level='L';\n  if(!points && level==='L') points='0';\n  return {text:s, code, level, points};\n}\n\n/* =====================================================================\n * 3. 結果顯示與編修\n * ===================================================================== */\nfunction renderResult(){\n  const r=S.rec;\n  $('kindTag').textContent = r ? (r._fromSaved?'已儲存的結果':(r.kind?r.kind+'紀錄表':'')) : '';\n  if(!S.sel){ $('resultBox').innerHTML='<div class=\"empty-hint\">請先在左側選擇案件。</div>'; return; }\n  if(!r){ $('resultBox').innerHTML='<div class=\"empty-hint\">請在左側上傳紀錄表'+(canEdit()?'；或 <button id=\"startManual\">直接手動輸入</button>':'')+'</div>';\n    if($('startManual')) $('startManual').onclick=()=>{ S.rec={v:2,kind:'',score:'',good:[],bad:[],design:[],other:[],inspect:'',quality:'',fields:{},badTotal:''}; renderResult(); renderCmp(); updateSave(); }; return; }\n  const ro = !canEdit();\n  const lst = (k,label) => `<div class=\"sub\">${label}<span class=\"muted\" style=\"font-weight:400\">（一行一條，共 ${(r[k]||[]).length} 條）</span></div><textarea data-list=\"${k}\" rows=\"${Math.min(10,Math.max(2,(r[k]||[]).length+1))}\" ${ro?'disabled':''}>${esc((r[k]||[]).join('\\n'))}</textarea>`;\n  $('resultBox').innerHTML = `\n    <div class=\"scorebox\"><label>分數 <input type=\"text\" id=\"rScore\" value=\"${esc(r.score)}\" ${ro?'disabled':''} placeholder=\"例 82 或 不計分\"></label><span class=\"grade\" id=\"rGrade\">${esc(gradeOf(r.score))}</span>\n      <span class=\"muted\" id=\"rSum\"></span></div>\n    ${lst('good','優點')}\n    <div class=\"sub\">缺點<span class=\"muted\" style=\"font-weight:400\">（代碼、等級、扣點可修改；扣點以紀錄表為準）</span>${ro?'':'<button class=\"mini\" id=\"addBad\">＋新增</button>'}</div>\n    <table class=\"items\"><thead><tr><th class=\"w-no\">#</th><th>內容</th><th class=\"w-code\">缺失代碼</th><th class=\"w-lv\">等級</th><th class=\"w-pt\">扣點</th>${ro?'':'<th class=\"w-del\"></th>'}</tr></thead><tbody>${\n      r.bad.map((d,i)=>{ const hint=d.code?String(S.codes[d.code]||'').replace(/□/g,''):''; const flag=!d.code||!S.codes[d.code];\n        return `<tr class=\"${flag?'flag':''}\" data-i=\"${i}\"><td>${i+1}</td><td><textarea data-f=\"text\" rows=\"2\" ${ro?'disabled':''}>${esc(d.text)}</textarea></td>\n        <td><input data-f=\"code\" value=\"${esc(d.code)}\" list=\"codeList\" ${ro?'disabled':''}><div class=\"codehint\">${d.code?(hint?esc(hint.slice(0,40)):'⚠ 缺失扣點表無此代碼'):'⚠ 未填代碼'}</div></td>\n        <td><select data-f=\"level\" ${ro?'disabled':''}>${['','L','M','S'].map(x=>`<option ${x===d.level?'selected':''}>${x}</option>`).join('')}</select></td>\n        <td><input data-f=\"points\" value=\"${esc(d.points)}\" ${ro?'disabled':''}></td>${ro?'':'<td><button class=\"mini\" data-del=\"'+i+'\" title=\"刪除\">✕</button></td>'}</tr>`; }).join('') || `<tr><td colspan=\"6\" class=\"muted\">沒有缺點</td></tr>`\n    }</tbody></table>\n    ${lst('design','規劃設計問題及建議')}\n    ${lst('other','其他建議')}\n    <div class=\"sub\">檢驗拆驗</div><textarea id=\"rInspect\" rows=\"2\" ${ro?'disabled':''}>${esc(r.inspect)}</textarea>\n    ${r.kind==='查核'||r.quality?`<div class=\"sub\">品質指標</div><textarea id=\"rQuality\" rows=\"2\" ${ro?'disabled':''}>${esc(r.quality)}</textarea>`:''}\n    <ul class=\"checks\" id=\"checks\"></ul>`;\n  const box=$('resultBox');\n  $('rScore').oninput=e=>{ r.score=e.target.value.trim(); $('rGrade').textContent=gradeOf(r.score); renderChecks(); };\n  box.querySelectorAll('[data-list]').forEach(t=>t.oninput=()=>{ r[t.dataset.list]=t.value.split('\\n').map(s=>s.trim()).filter(Boolean); renderChecks(); });\n  box.querySelectorAll('tr[data-i] [data-f]').forEach(el=>{ el.oninput=()=>{ r.bad[+el.closest('tr').dataset.i][el.dataset.f]=el.value.trim(); renderChecks(); }; });\n  box.querySelectorAll('tr[data-i] [data-f=\"code\"]').forEach(el=>el.onchange=()=>{ r.bad[+el.closest('tr').dataset.i].code=el.value.trim(); renderResult(); });\n  box.querySelectorAll('tr[data-i] [data-f=\"level\"]').forEach(el=>el.onchange=()=>{ r.bad[+el.closest('tr').dataset.i].level=el.value; renderChecks(); });\n  box.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{ r.bad.splice(+b.dataset.del,1); renderResult(); });\n  if($('addBad')) $('addBad').onclick=()=>{ r.bad.push({text:'',code:'',level:'L',points:'0'}); renderResult(); };\n  $('rInspect').oninput=e=>{ r.inspect=e.target.value; };\n  if($('rQuality')) $('rQuality').oninput=e=>{ r.quality=e.target.value; };\n  renderChecks();\n}\nfunction renderChecks(){\n  const r=S.rec, out=[]; if(!r||!$('checks')) return;\n  const sc=num(r.score), tot=r.bad.reduce((a,d)=>a+(num(d.points)||0),0);\n  $('rSum').textContent='缺點 '+r.bad.length+' 項｜扣點合計 '+tot+' 點';\n  if(!r.score) out.push(['err','未填分數']); else if(r.score!=='不計分' && (sc==null||sc<0||sc>100)) out.push(['err','分數格式不正確']);\n  const noCode=r.bad.filter(d=>!d.code).length; if(noCode) out.push(['warn',`${noCode} 項缺點未填缺失代碼`]);\n  const bad=r.bad.filter(d=>d.code&&!S.codes[d.code]).length; if(bad) out.push(['warn',`${bad} 項缺失代碼不在缺失扣點表`]);\n  if(r.badTotal!==''&&r.badTotal!=null&&+r.badTotal!==tot) out.push(['warn',`扣點合計 ${tot} 點，與紀錄表記載 ${r.badTotal} 點不同`]);\n  const f=r.fields||{};\n  if(S.sel && f.date){ const d=rocToIso(f.date); if(d && S.sel['日期'] && d!==S.sel['日期']) out.push(['err',`紀錄表日期 ${R(d)} 與案件日期 ${R(S.sel['日期'])} 不同，請確認是否選錯案件`]); }\n  if(S.sel && f.name && nameKey(f.name)!==nameKey(S.sel['工程名稱'])) out.push(['err','紀錄表標案名稱與案件工程名稱不同，請確認是否選錯案件']);\n  if(!out.length) out.push(['ok','檢查通過']);\n  $('checks').innerHTML=out.map(([c,m])=>`<li class=\"${c}\">${esc(m)}</li>`).join('');\n}\n\n/* =====================================================================\n * 4. 工程基本資料比對\n * ===================================================================== */\nconst CMP = [\n  // [欄位, 紀錄表取值, 可更新]\n  ['日期', f=>rocToIso(f.date), false],\n  ['工程名稱', f=>f.name, false],\n  ['所屬計畫', f=>f.plan, true],\n  ['縣市鄉鎮', f=>f.place, true],\n  ['發包預算', f=>{ const n=num((String(f.budget||'').match(/[\\d,.]+/)||[''])[0]); return n==null?'':String(n); }, true],\n  ['契約金額', f=>{ const s=String(f.contract||''); const m=s.match(/變更設計後[：:]?\\s*([\\d,.]+)/)||s.match(/([\\d,.]+)/); const n=m?num(m[1]):null; return n==null?'':String(n); }, true],\n  ['設計單位', f=>f.designer, true],\n  ['監造單位', f=>f.supervisor, true],\n  ['專案管理單位', f=>f.pcm, true],\n  ['承包商', f=>f.contractor, true],\n  ['委員1', f=>committees(f.committee)[0]||'', true],\n  ['委員2', f=>committees(f.committee)[1]||'', true],\n  ['領隊', f=>{ const m=String(f.leader||'').match(/領隊[：:]\\s*([^\\s(（\\n]+)/); return m?m[1]:''; }, true],\n  ['工作人員', f=>{ const m=String(f.leader||'').match(/工作人員[：:]\\s*([^\\n]+)/); return m?m[1].trim():''; }, true],\n  ['開工日期', f=>rocToIso(String(f.period||'')), true]\n];\nfunction committees(s){\n  return String(s||'').replace(/內聘[：:]\\s*[(（]?無[)）]?/g,'').replace(/(內聘|外聘)[：:]/g,'、').split(/[、,，\\s]+/).map(x=>x.trim()).filter(x=>/^[一-鿿]{2,4}$/.test(x)&&x!=='無');\n}\nconst cmpEq = (k,a,b) => { if(k==='發包預算'||k==='契約金額'){ const x=num(a), y=num(b); return x!=null&&y!=null&&Math.abs(x-y)<0.6; } return nameKey(a)===nameKey(b); };\nfunction renderCmp(){\n  const r=S.rec, c=S.sel;\n  if(!c||!r||!r.fields||!Object.values(r.fields).some(Boolean)){ $('cmpBox').innerHTML='<div class=\"empty-hint\">'+(r&&r._fromSaved?'目前顯示已儲存的結果；上傳紀錄表後可比對。':'上傳紀錄表後自動比對。')+'</div>'; S.cmp=[]; return; }\n  S.cmp = CMP.map(([k,fn,upd])=>{ const rv=String(fn(r.fields)||'').trim(), sv=String(c[k]==null?'':c[k]).trim(); const same=!rv || cmpEq(k,rv,sv); return {k, rv, sv, upd, same, use: upd && !!rv && !sv}; });\n  const ro=!canEdit(), D=k=>k==='日期'||k==='開工日期';\n  $('cmpBox').innerHTML = `<table class=\"cmp\"><thead><tr><th>欄位</th><th>紀錄表</th><th>系統資料庫</th><th>結果</th><th>更新</th></tr></thead><tbody>${\n    S.cmp.map((x,i)=>`<tr class=\"${x.same?'same':'diff'}\"><td class=\"k\">${esc(x.k)}</td><td>${esc(D(x.k)?R(x.rv):x.rv)||'<span class=\"muted\">—</span>'}</td><td>${esc(D(x.k)?R(x.sv):x.sv)||'<span class=\"muted\">—</span>'}</td>\n      <td class=\"st\">${!x.rv?'<span class=\"muted\">紀錄表無</span>':x.same?'✔ 相同':x.sv?'不同':'系統空白'}</td>\n      <td>${x.upd && x.rv && !x.same ? `<input type=\"checkbox\" data-u=\"${i}\" ${x.use?'checked':''} ${ro?'disabled':''}>` : ''}</td></tr>`).join('')\n  }</tbody></table><div class=\"note\">預設只勾選「系統空白」的欄位；「不同」的欄位請確認後再勾選。日期、工程名稱不同時請確認是否選錯案件（不會更新）。</div>`;\n  $('cmpBox').querySelectorAll('[data-u]').forEach(cb=>cb.onchange=()=>{ S.cmp[+cb.dataset.u].use=cb.checked; });\n  renderChecks();\n}\n\n/* =====================================================================\n * 5. 儲存\n * ===================================================================== */\nconst SAVE_TXT='儲存結果到資料庫（含紀錄表原檔）';\nfunction updateSave(){\n  $('rBtnSave').disabled=!(S.sel && S.rec);\n  $('saveHint').textContent = !S.sel ? '請選擇案件' : !S.rec ? '請上傳紀錄表或手動輸入' : (S.file ? '將儲存：成績、缺失、完整內容與紀錄表原檔' : '將儲存：成績、缺失與完整內容（未附原檔）');\n}\nasync function save(force){\n  if(!S.sel||!S.rec) return;\n  const r=S.rec;\n  if(!force && !r.score && !confirm('尚未填分數，仍要儲存？')) return;\n  const info={}; (S.cmp||[]).forEach(x=>{ if(x.use && x.upd) info[x.k]=x.rv; });\n  const content={ v:2, kind:r.kind, title:r.title||'', score:r.score, good:r.good, bad:r.bad, design:r.design, other:r.other, inspect:r.inspect, quality:r.quality, badTotal:r.badTotal||'', fields:r.fields||{},\n    source: S.file ? S.file.name : ((S.saved&&S.saved.content&&S.saved.content.source)||'') };\n  const args={ id:S.sel['案件編號'], score:r.score, defects:r.bad.map(d=>({text:d.text, code:d.code, level:d.level, points:d.points})), content, info, force:!!force };\n  $('rBtnSave').disabled=true; $('rBtnSave').textContent='儲存中…';\n  try{\n    if(S.file) args.file={ name:S.file.name, mimeType:S.file.file.type || ({odt:'application/vnd.oasis.opendocument.text',docx:'application/vnd.openxmlformats-officedocument.wordprocessingml.document',doc:'application/msword',pdf:'application/pdf'})[S.file.ext], base64: await blobToB64(S.file.file) };\n    const res=await api('djSaveRecord', args);\n    if(res.needConfirm){\n      $('rBtnSave').textContent=SAVE_TXT; updateSave();\n      if(confirm(`此案件已有成績（${res.oldScore||'無'}）及 ${res.existing} 筆缺失，儲存後會以本次內容取代，確定？`)) return save(true);\n      return;\n    }\n    toast('已儲存：成績 '+(r.score||'—')+'、缺失 '+res.defects+' 筆'+(res.file?'、原檔 '+res.file:''), 4000);\n    Object.assign(S.sel, { 成績: r.score, 缺失數: String(res.defects||''), 缺失未建立: false, 原檔: (S.sel['原檔']||0)+(res.file?1:0) }, info);\n    S.file=null; S.rec._fromSaved=true; renderFile(); renderCases(); selectCase(S.sel['案件編號']);\n    if(window.REC_onSaved) window.REC_onSaved(S.sel['案件編號']);\n  }catch(e){ toast('儲存失敗：'+(e.message||e), 5000); }\n  $('rBtnSave').textContent=SAVE_TXT; updateSave();\n}\n$('rBtnSave').onclick=()=>save(false);\n\nfunction recStart(){ setupDrop(); renderResult(); renderCmp(); updateSave(); loadInit(); }\nwindow.REC = {\n  start: recStart,\n  open(id){ PRE_ID=id||''; preDone=false; const c=S.cases.find(x=>x['案件編號']===id); if(c){ preDone=true; focusCase(c); } }\n};\nwindow.__REC_parse = lines => parseRecord(lines);   // 測試用\nif(!window.REC_EMBED) recStart();\n\n})();\n</script>\n"}